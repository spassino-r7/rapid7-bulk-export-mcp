# InsightVM Data Warehouse connection settings
IVM_DW_HOST=192.168.1.216
IVM_DW_PORT=5432
IVM_DW_DB=dhouse
IVM_DW_USER=mcp_readonly

# Password retrieval method: "keychain" (macOS) or "env"
IVM_DW_AUTH_METHOD=keychain

# If using keychain (macOS):
IVM_DW_KEYCHAIN_SERVICE=insightvm-warehouse
IVM_DW_KEYCHAIN_ACCOUNT=mcp_readonly

# If using env-based auth (set this instead):
# IVM_DW_PASSWORD=your_password_here

# Query safety limits
IVM_DW_STATEMENT_TIMEOUT=30000
IVM_DW_ROW_LIMIT=500
